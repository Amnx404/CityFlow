<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <!-- Single vehicle type: IDM + LC2013 with SUMO defaults -->
    <vType id="car_idm" carFollowModel="IDM" accel="2.6" decel="4.5" emergencyDecel="9.0" sigma="0.5" tau="1.0" minGap="2.5" maxSpeed="33.33" length="5.0" width="1.8" laneChangeModel="LC2013" lcStrategic="1.0" lcCooperative="1.0" lcSpeedGain="1.0" lcKeepRight="1.0"/>

    <!-- Main road flow  (3 lanes, random departure lane) -->
    <flow id="main_flow"
          type="car_idm"
          from="main_before"
          to="main_after"
          begin="0"
          end="600"
          vehsPerHour="3600"
          departLane="random"
          departSpeed="max"
          color="0,0,200"/>

    <!-- On-ramp / merge flow -->
    <flow id="merge_flow"
          type="car_idm"
          from="ramp"
          to="main_after"
          begin="0"
          end="600"
          vehsPerHour="600"
          departLane="0"
          departSpeed="max"
          color="200,0,0"/>

</routes>
